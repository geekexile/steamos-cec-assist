# --------------------------------------------------------------------------
# daemon
# --------------------------------------------------------------------------
DEFAULTS = {
    "settle_seconds": "1.0",
    "controller_trigger": "true",
    "controller_cooldown_seconds": "30",
    "controller_names": "Steam Controller, X-Box 360 pad, Steam Deck",
    "log_routing": "true",
}


def load_config():
    cp = configparser.ConfigParser()
    cp["daemon"] = DEFAULTS
    cp.read(CONFIG_FILE)
    return cp["daemon"]


class Daemon:
    EV_KEY, EV_ABS = 0x01, 0x03
    ABS_HAT0X, ABS_HAT0Y = 0x10, 0x11
    EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit

    def __init__(self, cfg):
        self.settle = cfg.getfloat("settle_seconds")
        self.controller_trigger = cfg.getboolean("controller_trigger")
        self.cooldown = cfg.getfloat("controller_cooldown_seconds")
        self.controller_names = [n.strip() for n in cfg["controller_names"].split(",") if n.strip()]
        self.log_routing = cfg.getboolean("log_routing")
        self.obj = device_obj()
        self.timer = None
        self.lock = threading.Lock()
        self.current_route = None

    # -- claiming ---------------------------------------------------------
    def claim_now(self, reason):
        with self.lock:
            self.timer = None
        ok, err = set_active_source(self.obj)
        log(f"claimed active source ({reason})" if ok else f"SetActiveSource failed ({reason}): {err}")

    def claim_later(self, reason):
        """Trailing debounce: the TV sends Routing Change and Set Stream Path in
        quick succession (either order); answer only after the burst ends."""
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
            self.timer = threading.Timer(self.settle, self.claim_now, args=(reason,))
            self.timer.daemon = True
            self.timer.start()

    def cancel(self, reason):
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
                self.timer = None
                log(f"pending claim cancelled ({reason})")

    # -- CEC routing ------------------------------------------------------
    def handle(self, src, msg):
        if not msg:
            return
        op, args = msg[0], msg[1:]
        if op not in ROUTING_OPS:
            return
        if self.log_routing:
            log(f"rx {LOGICAL_NAMES[src & 15]}: {ROUTING_OPS[op]} " + " ".join(f"{b:02x}" for b in msg))
        ours = own_phys_addr(self.obj)
        if op == OP_ACTIVE_SOURCE:
            self.current_route = pa_from(args)
            if src != 0 and not on_our_branch(self.current_route, ours):
                self.cancel(f"{LOGICAL_NAMES[src & 15]} became active source at {fmt_pa(self.current_route)}")
            return
        if op == OP_REQUEST_ACTIVE_SOURCE:
            if on_our_branch(self.current_route, ours):
                self.claim_later("TV asked for active source while on our input")
            return
        if op == OP_SET_STREAM_PATH:
            route = pa_from(args)
        elif op == OP_ROUTING_CHANGE:
            route = pa_from(args, 2)
        else:
            return
        self.current_route = route
        if src != 0:
            return
        if on_our_branch(route, ours):
            self.claim_later(f"TV routed to {fmt_pa(route)}, we are {fmt_pa(ours)}")
        else:
            self.cancel(f"TV routed to {fmt_pa(route)}")

    # -- controller trigger -----------------------------------------------
    def controller_devices(self):
        found = {}
        try:
            blocks = open("/proc/bus/input/devices").read().split("\n\n")
        except OSError:
            return found
        for b in blocks:
            name = re.search(r'^N: Name="(.*)"', b, re.M)
            ev = re.search(r"\b(event\d+)\b", b)
            if name and ev and any(n in name.group(1) for n in self.controller_names):
                found[f"/dev/input/{ev.group(1)}"] = name.group(1)
        return found

    def watch_controller(self):
        fds, last_scan, last_claim = {}, 0.0, 0.0
        while True:
            now = time.monotonic()
            if now - last_scan > 10:  # pick up reconnects / new virtual pads
                last_scan = now
                wanted = self.controller_devices()
                for fd, path in list(fds.items()):
                    if path not in wanted:
                        os.close(fd)
                        del fds[fd]
                have = set(fds.values())
                for path in wanted:
                    if path not in have:
                        try:  # read-only, never grabbed: other apps still get input
                            fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                        except OSError:
                            pass
            if not fds:
                time.sleep(5)
                continue
            ready, _, _ = select.select(list(fds), [], [], 5)
            pressed = False
            for fd in ready:
                try:
                    data = os.read(fd, self.EVENT.size * 64)
                except OSError:
                    os.close(fd)
                    del fds[fd]
                    continue
                for i in range(0, len(data) - self.EVENT.size + 1, self.EVENT.size):
                    _, _, etype, code, value = self.EVENT.unpack_from(data, i)
                    if (etype == self.EV_KEY and value == 1) or (
                            etype == self.EV_ABS and code in (self.ABS_HAT0X, self.ABS_HAT0Y) and value != 0):
                        pressed = True
            if pressed and time.monotonic() - last_claim > self.cooldown:
                last_claim = time.monotonic()
                self.claim_now("controller used")

    def run(self):
        log(f"cec-assist {VERSION} daemon started (device {self.obj}, "
            f"controller trigger {'on' if self.controller_trigger else 'off'})")
        if self.controller_trigger:
            def guarded():
                while True:
                    try:
                        self.watch_controller()
                    except Exception as e:
                        log(f"controller watcher error, restarting: {e!r}")
                        time.sleep(5)
            threading.Thread(target=guarded, daemon=True).start()
        for src, msg in dbus_cec_messages():
            try:
                self.handle(src, msg)
            except Exception as e:  # never die on one odd message
                log(f"error handling {msg}: {e!r}")


def cmd_daemon(_args):
    Daemon(load_config()).run()


# --------------------------------------------------------------------------
# claim
# --------------------------------------------------------------------------
def cmd_claim(_args):
    if not cecd_active():
        print("cecd is not running, restarting it...")
        restart_cecd()
    for _ in range(10):  # cecd needs a moment to (re)open the CEC device
        if cecd_active():
            ok, _err = set_active_source(device_obj())
            if ok:
                print("This device is now the CEC active source.")
                return 0
        time.sleep(1)
    print("Failed to claim CEC active source. Recent cecd log:", file=sys.stderr)
    print(run(["journalctl", "--user", "-u", "cecd", "-n", "8", "--no-pager", "-o", "cat"]).stdout,
          file=sys.stderr)
    return 1


# --------------------------------------------------------------------------
# monitor
# --------------------------------------------------------------------------
def cmd_monitor(args):
    obj = device_obj()
    print(f"Our physical address: {fmt_pa(own_phys_addr(obj))}. "
          "Showing routing messages and remote presses (Ctrl+C to stop).", flush=True)
    deadline = time.monotonic() + args.seconds if args.seconds else None

    def stop_after():
        time.sleep(args.seconds)
        os._exit(0)
    if deadline:
        threading.Thread(target=stop_after, daemon=True).start()
    try:
        for src, msg in dbus_cec_messages():
            op, a = msg[0], msg[1:]
            who = LOGICAL_NAMES[src & 15]
            ts = time.strftime("%H:%M:%S")
            if op == OP_USER_CONTROL_PRESSED and a:
                print(f"{ts}  {who}: button {UI_NAMES.get(a[0], hex(a[0]))} (0x{a[0]:02x})", flush=True)
            elif op in ROUTING_OPS and (args.all or op not in (OP_REPORT_PHYS_ADDR,)):
                extra = ""
                if op in (OP_ACTIVE_SOURCE, OP_SET_STREAM_PATH, OP_ROUTING_INFO,
                          OP_INACTIVE_SOURCE, OP_REPORT_PHYS_ADDR):
                    extra = fmt_pa(pa_from(a))
                elif op == OP_ROUTING_CHANGE:
                    extra = f"{fmt_pa(pa_from(a))} -> {fmt_pa(pa_from(a, 2))}"
                print(f"{ts}  {who}: {ROUTING_OPS[op]} {extra}", flush=True)
            elif args.all:
                print(f"{ts}  {who}: " + " ".join(f"{b:02x}" for b in msg), flush=True)
    except KeyboardInterrupt:
        return 0


