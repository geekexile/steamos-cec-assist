# remap
# --------------------------------------------------------------------------
def parse_override(spec):
    if "=" not in spec:
        raise ValueError(f"expected BUTTON=KEY, got {spec!r}")
    btn, key = (s.strip() for s in spec.split("=", 1))
    b = btn.lower()
    if b.startswith("0x"):
        code = int(b, 16)
    elif b in UI_CODES:
        code = UI_CODES[b]
    else:
        raise ValueError(f"unknown button {btn!r} (see: cec-assist remap --list-buttons)")
    k = key.upper()
    if not k.startswith("KEY_") and not k.isdigit():
        k = "KEY_" + k
    if k.isdigit():
        val = int(k)
    elif k in KEY_CODES:
        val = KEY_CODES[k]
    else:
        raise ValueError(f"unknown key {key!r}: use a KEY_* name from --list-keys or a number")
    return code, val


def read_overrides():
    """Overrides currently in our mapping file (marked with '# override')."""
    out = {}
    try:
        for line in open(MAPPING_FILE):
            m = re.match(r'\s*"?([a-z0-9-]+)"?\s*=\s*(\d+)\s*#.*override', line)
            if m and m.group(1) in UI_CODES:
                out[UI_CODES[m.group(1)]] = int(m.group(2))
    except OSError:
        pass
    return out


def write_mapping_file(overrides):
    lines = [
        "# Written by cec-assist: cecd's full default button table plus overrides.",
        "# A [mappings] table REPLACES cecd's defaults, so every button is listed.",
        "# Change with `cec-assist remap`; remove with `cec-assist remap --reset`.",
        "[mappings]",
    ]
    for code in sorted(STOCK_MAPPINGS):
        name = UI_NAMES[code]
        key = name if name[0].isalpha() else f'"{name}"'
        if code in overrides:
            lines.append(f"{key} = {overrides[code]}  # 0x{code:02x} override "
                         f"(default {key_label(STOCK_MAPPINGS[code])}) -> {key_label(overrides[code])}")
        else:
            lines.append(f"{key} = {STOCK_MAPPINGS[code]}  # 0x{code:02x} {key_label(STOCK_MAPPINGS[code])}")
    for code in sorted(set(overrides) - set(STOCK_MAPPINGS)):
        name = UI_NAMES[code]
        key = name if name[0].isalpha() else f'"{name}"'
        lines.append(f"{key} = {overrides[code]}  # 0x{code:02x} override (no default) -> "
                     f"{key_label(overrides[code])}")
    os.makedirs(CECD_CONFIG_DIR, exist_ok=True)
    tmp = MAPPING_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, MAPPING_FILE)


def foreign_mapping_files():
    """Other cecd config files that also define [mappings]."""
    if not os.path.isdir(CECD_CONFIG_DIR):
        return []
    out = []
    for f in sorted(os.listdir(CECD_CONFIG_DIR)):
        p = os.path.join(CECD_CONFIG_DIR, f)
        if f.endswith(".toml") and p != MAPPING_FILE:
            try:
                if re.search(r"^\s*\[mappings\]", open(p).read(), re.M):
                    out.append(f)
            except OSError:
                pass
    return out


def apply_with_rollback(change):
    """Run change(), restart cecd; on failure restore the previous file."""
    backup = None
    if os.path.exists(MAPPING_FILE):
        backup = open(MAPPING_FILE).read()
    change()
    restart_cecd()
    time.sleep(2)
    if cecd_active():
        set_active_source(device_obj())  # restarting cecd drops active source
        return True
    err = run(["journalctl", "--user", "-u", "cecd", "-n", "5", "--no-pager", "-o", "cat"]).stdout
    if backup is None:
        os.remove(MAPPING_FILE)
    else:
        open(MAPPING_FILE, "w").write(backup)
    restart_cecd()
    print("cecd rejected the new mappings; rolled back.\n" + err, file=sys.stderr)
    return False


def cmd_remap(args):
    if args.list_buttons:
        for code in sorted(UI_NAMES):
            d = STOCK_MAPPINGS.get(code)
            print(f"0x{code:02x}  {UI_NAMES[code]:30s} default: {key_label(d) if d is not None else '-'}")
        return 0
    if args.list_keys:
        for n, c in sorted(KEY_CODES.items(), key=lambda x: x[1]):
            print(f"{c:4d}  {n}")
        print("Any other Linux keycode can be given as a number.")
        return 0
    clash = foreign_mapping_files()
    if clash:
        print(f"Warning: other cecd config files also set [mappings]: {', '.join(clash)}. "
              "Files are applied in name order, so remove them to avoid surprises.", file=sys.stderr)
    if args.reset:
        if not os.path.exists(MAPPING_FILE):
            print("No cec-assist mappings installed; cecd uses its defaults.")
            return 0
        ok = apply_with_rollback(lambda: os.remove(MAPPING_FILE))
        print("Removed cec-assist mappings; cecd is back to its defaults." if ok else "Reset failed.")
        return 0 if ok else 1
    current = read_overrides()
    if not args.overrides:
        if not current:
            print("No overrides (cecd defaults). Example: cec-assist remap select=KEY_PLAYPAUSE")
        for code, val in sorted(current.items()):
            print(f"{UI_NAMES[code]:20s} -> {key_label(val)}  (default {key_label(STOCK_MAPPINGS.get(code, 0))})")
        return 0
    try:
        new = dict(current)
        for spec in args.overrides:
            code, val = parse_override(spec)
            if STOCK_MAPPINGS.get(code) == val:
                new.pop(code, None)  # mapping back to the default = drop the override
            else:
                new[code] = val
    except ValueError as e:
        print(e, file=sys.stderr)
        return 2
    if not new:
        return cmd_remap(argparse.Namespace(**{**vars(args), "reset": True, "overrides": []}))
    ok = apply_with_rollback(lambda: write_mapping_file(new))
    if ok:
        print("Mappings applied:")
        for code, val in sorted(new.items()):
            print(f"  {UI_NAMES[code]:20s} -> {key_label(val)}")
    return 0 if ok else 1


# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------
def cmd_status(_args):
    obj = device_obj()
    up = cecd_active()
    print(f"cecd:            {'running' if up else 'NOT running'}")
    if up:
        print(f"CEC device:      {obj}")
        print(f"physical addr:   {fmt_pa(own_phys_addr(obj))}")
        la = (get_prop(obj, DEV_IFACE, "LogicalAddresses") or "").split()[2:]  # "ay N a b..."
        print("logical addrs:   " + (", ".join(f"{a} ({LOGICAL_NAMES[int(a) & 15]})" for a in la) or "none"))
        upd = (get_prop(DAEMON_OBJ, CFG_IFACE, "Uinput") or "? ?").split()[-1]
        print(f"remote->keys:    {'enabled' if upd == 'true' else 'DISABLED (uinput off)' if upd == 'false' else '?'}")
    d = run(["systemctl", "--user", "is-active", "cec-assist"]).stdout.strip()
    print(f"cec-assist:      {d}")
    ov = read_overrides()
    print("remaps:          " + (", ".join(f"{UI_NAMES[c]}->{key_label(v)}" for c, v in sorted(ov.items()))
                                 if ov else "none from cec-assist"))
    for f in foreign_mapping_files():
        print(f"                 also: {os.path.join(CECD_CONFIG_DIR, f)} sets [mappings] (not managed by cec-assist)")
    print(f"config:          {CONFIG_FILE if os.path.exists(CONFIG_FILE) else 'defaults'}")
    return 0


# --------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(prog="cec-assist", description=__doc__.split("\n\n")[0])
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("daemon", help="run the background fixer (used by the systemd unit)")
    sub.add_parser("claim", help="claim CEC active source now")
    m = sub.add_parser("monitor", help="show CEC routing messages and remote presses")
    m.add_argument("-s", "--seconds", type=int, default=0, help="stop after N seconds")
    m.add_argument("-a", "--all", action="store_true", help="show every CEC message")
    r = sub.add_parser("remap", help="remap remote buttons (keeps all other defaults)",
                       description="e.g. cec-assist remap select=KEY_PLAYPAUSE left=KEY_PREVIOUSSONG")
    r.add_argument("overrides", nargs="*", metavar="BUTTON=KEY")
    r.add_argument("--reset", action="store_true", help="remove all overrides")
    r.add_argument("--list-buttons", action="store_true", help="list remote button names")
    r.add_argument("--list-keys", action="store_true", help="list known key names")
    sub.add_parser("status", help="show current state")
    args = ap.parse_args()
    return {"daemon": cmd_daemon, "claim": cmd_claim, "monitor": cmd_monitor,
            "remap": cmd_remap, "status": cmd_status}[args.cmd](args) or 0


if __name__ == "__main__":
    sys.exit(main())
