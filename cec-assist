#!/usr/bin/env python3
"""cec-assist: keep a TV remote working with SteamOS's HDMI-CEC daemon (cecd).

Subcommands:
  daemon   Background fixer: claims CEC "active source" when the TV switches to
           this device's input (incl. through HDMI switches/AVRs that don't
           forward CEC routing) and, optionally, when the Steam Controller is used.
  claim    Claim active source now (restarts cecd first if it isn't running).
  monitor  Show CEC routing messages and remote button presses live.
  remap    Remap remote buttons to other keys, keeping cecd's full default table.
  status   Show cecd / daemon / mapping state.

Only uses the Python standard library plus gdbus/busctl/dbus-monitor/systemctl,
which ship with SteamOS. Talks to cecd over the session D-Bus; never needs root.
"""
import argparse
import configparser
import os
import re
import select
import struct
import subprocess
import sys
import threading
import time

VERSION = "0.1.0"

# --------------------------------------------------------------------------
# cecd D-Bus plumbing
# --------------------------------------------------------------------------
DEST = "com.steampowered.CecDaemon1"
DEV_IFACE = "com.steampowered.CecDaemon1.CecDevice1"
CFG_IFACE = "com.steampowered.CecDaemon1.Config1"
DAEMON_OBJ = "/com/steampowered/CecDaemon1/Daemon"
DEFAULT_DEV_OBJ = "/com/steampowered/CecDaemon1/Devices/Cec0"

CECD_CONFIG_DIR = os.path.expanduser("~/.config/cecd/config.d")
MAPPING_FILE = os.path.join(CECD_CONFIG_DIR, "50-cec-assist-mappings.toml")
CONFIG_FILE = os.path.expanduser("~/.config/cec-assist/config.ini")


def log(msg):
    print(msg, flush=True)


def run(cmd, timeout=10):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def device_obj():
    """Object path of the first CEC device cecd exposes."""
    try:
        out = run(["busctl", "--user", "tree", "--list", DEST]).stdout
        devs = [l.strip() for l in out.splitlines() if "/Devices/" in l]
        if devs:
            return sorted(devs)[0]
    except Exception:
        pass
    return DEFAULT_DEV_OBJ


def get_prop(obj, iface, prop):
    r = run(["busctl", "--user", "get-property", DEST, obj, iface, prop])
    return r.stdout.strip() if r.returncode == 0 else None


def own_phys_addr(obj):
    out = get_prop(obj, DEV_IFACE, "PhysicalAddress")  # e.g. "q 8704"
    try:
        return int(out.split()[-1])
    except Exception:
        return None


def set_active_source(obj):
    r = run(["gdbus", "call", "--session", "-d", DEST, "-o", obj, "-m",
             f"{DEV_IFACE}.SetActiveSource", "--", "-1"])
    return r.returncode == 0, r.stderr.strip()


def cecd_active():
    return run(["systemctl", "--user", "is-active", "--quiet", "cecd"]).returncode == 0


def restart_cecd():
    run(["systemctl", "--user", "reset-failed", "cecd"])
    return run(["systemctl", "--user", "restart", "cecd"], timeout=30).returncode == 0


# --------------------------------------------------------------------------
# CEC helpers
# --------------------------------------------------------------------------
OP_ROUTING_CHANGE = 0x80
OP_ROUTING_INFO = 0x81
OP_ACTIVE_SOURCE = 0x82
OP_REPORT_PHYS_ADDR = 0x84
OP_REQUEST_ACTIVE_SOURCE = 0x85
OP_SET_STREAM_PATH = 0x86
OP_INACTIVE_SOURCE = 0x9D
OP_STANDBY = 0x36
OP_IMAGE_VIEW_ON = 0x04
OP_TEXT_VIEW_ON = 0x0D
OP_USER_CONTROL_PRESSED = 0x44

ROUTING_OPS = {
    OP_ROUTING_CHANGE: "Routing Change", OP_ROUTING_INFO: "Routing Information",
    OP_ACTIVE_SOURCE: "Active Source", OP_REQUEST_ACTIVE_SOURCE: "Request Active Source",
    OP_SET_STREAM_PATH: "Set Stream Path", OP_INACTIVE_SOURCE: "Inactive Source",
    OP_STANDBY: "Standby", OP_IMAGE_VIEW_ON: "Image View On", OP_TEXT_VIEW_ON: "Text View On",
    OP_REPORT_PHYS_ADDR: "Report Physical Address",
}
LOGICAL_NAMES = ["TV", "Recording 1", "Recording 2", "Tuner 1", "Playback 1", "Audio System",
                 "Tuner 2", "Tuner 3", "Playback 2", "Recording 3", "Tuner 4", "Playback 3",
                 "Backup 1", "Backup 2", "Specific", "Broadcast"]


def nibbles(pa):
    return [(pa >> s) & 0xF for s in (12, 8, 4, 0)]


def fmt_pa(pa):
    return "?" if pa is None else ".".join(str(n) for n in nibbles(pa))


def pa_from(b, i=0):
    return (b[i] << 8) | b[i + 1] if len(b) >= i + 2 else None


def on_our_branch(route, ours):
    """True if `route` is our physical address or an ancestor of it."""
    if ours is None or ours == 0xFFFF or route in (None, 0, 0xFFFF):
        return False
    r, o = nibbles(route), nibbles(ours)
    depth = 0
    while depth < 4 and r[depth] != 0:
        depth += 1
    return r[:depth] == o[:depth] and all(n == 0 for n in r[depth:])


def dbus_cec_messages(member="ReceivedMessage"):
    """Yield (initiator, message bytes) from cecd's D-Bus signal."""
    p = subprocess.Popen(
        ["dbus-monitor", "--session",
         f"type='signal',interface='{DEV_IFACE}',member='{member}'"],
        stdout=subprocess.PIPE, text=True)
    buf = []

    def parse(block):
        if f"member={member}" not in block:
            return None
        v = re.findall(r"^\s*byte (\d+)", block, re.M)
        arr = re.search(r"array of bytes \[\s*(.*?)\s*\]", block, re.S)
        s = re.search(r'array of bytes "(.*?)"', block)
        if arr:
            msg = [int(x, 16) for x in arr.group(1).split()]
        elif s:  # dbus-monitor prints NUL-terminated byte arrays as strings
            msg = [ord(c) for c in s.group(1)] + [0]
        else:
            return None
        if not v:
            return None
        return int(v[0]), msg

    try:
        for line in p.stdout:
            if line.startswith("signal ") and buf:
                buf = []
            buf.append(line.rstrip("\n"))
            st = line.strip()
            if st == "]" or st.startswith('array of bytes "'):
                res = parse("\n".join(buf))
                buf = []
                if res:
                    yield res
    finally:
        p.terminate()
    raise RuntimeError(f"dbus-monitor exited ({p.wait()})")


